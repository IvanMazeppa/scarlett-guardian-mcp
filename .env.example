GUARDIAN_HOST=0.0.0.0
GUARDIAN_PORT=8790
# Hobbyist static domain hostname only (no https://). See docs/mission-control-ngrok.md
NGROK_STATIC_DOMAIN=
GUARDIAN_MCP_BEARER_TOKEN=
RAG_MCP_URL=http://127.0.0.1:8787/mcp-v2
RAG_MCP_BEARER_TOKEN=
RAG_MCP_TIMEOUT_MS=30000
GUARDIAN_CONFIDENCE_THRESHOLD=70
GUARDIAN_LLM_ENABLED=true
OPENAI_API_KEY=OPENAI_API_KEY
GUARDIAN_MODEL=gpt-5.6-terra
GUARDIAN_LLM_MAX_EVIDENCE_CHARS=32000
GUARDIAN_EXPAND_BUDGET_MS=10000
GUARDIAN_VERIFY_BUDGET_MS=10000
# stage (default) | live | off — autonomous memory proposals after preflight
GUARDIAN_MEMORY_WRITE_MODE=stage
# WP-3.1 shadow duplex cache TTL (ms). Default 45 minutes.
GUARDIAN_DUPLEX_CACHE_TTL_MS=2700000
# WP-4.2 burn-in: none | beats (default, transitions hold) | beats_and_valid_transitions
GUARDIAN_AUTO_APPROVE=beats
# WP-5.3 dramaturg: background LLM pass (never blocks hot path). true by default.
GUARDIAN_DRAMATURG_ENABLED=true
GUARDIAN_DRAMATURG_STALENESS_TURNS=12
GUARDIAN_DRAMATURG_REASONING_EFFORT=medium
# WP-5.5: max optional resonance echoes in the brief (0 or 1)
GUARDIAN_ECHO_MAX_PER_TURN=1
